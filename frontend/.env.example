# Copy this file to .env and adjust values (used only for local dev).
#
# Leave unset to call the API same-origin via `/api`
# (the Vite dev proxy forwards it to http://localhost:3000).
#
# In production this is set at build time by Render to the backend URL, e.g.:
#   VITE_API_URL=https://grs-purchase-backend.onrender.com/api
# VITE_API_URL=