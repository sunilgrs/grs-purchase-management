# Copy this file to .env and adjust values.

# PostgreSQL connection (production = Render database connectionString)
DATABASE_URL="postgresql://grs_user:grs_dev_password@localhost:5432/grs_purchase"

# Port for local dev (Render injects PORT automatically in production)
PORT=3000

# Strong random secret for JWT signing. Generate with: openssl rand -hex 32
# In production Render generates this — never commit a real secret.
JWT_SECRET="change-me-in-prod"

# Token lifetime, e.g. 1d, 12h, 30m
JWT_EXPIRES_IN="1d"

# Comma-separated list of allowed browser origins (CORS).
# Local dev: the Vite dev server. Production: the Render frontend URL.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
