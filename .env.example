# Copy this file to .env and adjust values.
# Used by docker-compose.yml for the backend container environment.

# Strong random secret for JWT signing (required). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Token lifetime, e.g. 1d, 12h, 30m
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins for direct API calls.
# The Nginx container proxies /api (same-origin), so this mainly matters if
# you call the backend directly from another origin.
# CORS_ORIGINS=https://purchase.example.com

# Public address Caddy serves over HTTPS. Defaults to localhost.
#   - localhost / a private IP     -> automatic self-signed certificate (internal CA)
#   - a custom local hostname      -> set TLS_INTERNAL=internal below
#   - a public domain              -> automatic Let's Encrypt certificate
#     (ports 80/443 must reach this machine, and CORS_ORIGINS should use https://)
SITE_ADDRESS=localhost

# Use Caddy's internal CA for self-signed certificates. Required when SITE_ADDRESS
# is a custom local hostname that isn't "localhost" (e.g. ips-purchase-manager),
# otherwise Caddy tries Let's Encrypt and fails. Set empty for a public domain.
# Remember to map the hostname to 127.0.0.1 in C:\Windows\System32\drivers\etc\hosts.
TLS_INTERNAL=internal
