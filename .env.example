# Copy this file to .env and adjust values.
# Used by docker-compose.yml for the backend container environment.

# Strong random secret for JWT signing (required). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Token lifetime, e.g. 1d, 12h, 30m
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins for direct API calls.
# The Nginx container proxies /api (same-origin), so this mainly matters if
# you call the backend at :3000 directly from another origin.
# CORS_ORIGINS=https://purchase.example.com
