{$SITE_ADDRESS} {
	# HTTPS is automatic: Caddy uses its internal CA (self-signed) for
	# localhost / private IPs, or Let's Encrypt for public domains.
	# For local hostnames that aren't "localhost" (e.g. ips-purchase-manager),
	# force the internal CA. Set TLS_INTERNAL to empty for a public domain.
	tls {$TLS_INTERNAL:internal}
	encode gzip

	# The Nginx container serves the SPA and proxies /api to the backend.
	reverse_proxy frontend:80
}

# Plain HTTP entry point for phones on the same Wi-Fi. Phones don't send SNI
# for bare IPs, which breaks HTTPS-over-IP; HTTP avoids that entirely.
http://{$LAN_IP:192.168.1.33}:8080 {
	encode gzip
	reverse_proxy frontend:80
}

# Friendly hostname (http://ips-pms) resolved by the local dnsmasq DNS server
# on this PC; phones set their Wi-Fi DNS to this PC's LAN IP.
http://ips-pms {
	encode gzip
	reverse_proxy frontend:80
}
